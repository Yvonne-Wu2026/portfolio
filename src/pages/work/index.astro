---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { caseStudies } from '../../data/caseStudies';
import { shelfBooks } from '../../data/library';

/* Where each case study's book stands in the shelf photo, as percentages
   of the image: left, top, width, height. */
const spots: Record<string, [number, number, number, number]> = {
	pawtrainer: [39.2, 16.2, 10.5, 69.8],
	'watts-the-big-deal': [49.9, 19.3, 10.4, 66.7],
};

/* Each shelf book joined to its case study for the index below the shelf. */
const books = shelfBooks.map((book, i) => {
	const study = caseStudies.find((entry) => entry.slug === book.slug)!;
	const [left, top, width, height] = spots[book.slug];
	return {
		...book,
		study,
		numeral: ['I', 'II', 'III', 'IV', 'V', 'VI'][i] ?? String(i + 1),
		/* On the shelf's front edge, centred under the book. */
		plaque: `left: ${left + width / 2}%; width: ${width - 1}%;`,
		spot: `left: ${left}%; top: ${top}%; width: ${width}%; height: ${height}%; --ox: ${left + width / 2}%; --oy: ${top + height / 2}%;`,
	};
});

---

<Layout title="Work — Yvonne Wu" description="UX case studies by Yvonne Wu, kept on the shelf of the study.">
	<Nav />
	<main id="main" class="work">
		<header class="page intro">
			<p class="small-caps kicker">Chapter 02</p>
			<h1 class="title">The Shelf</h1>
			<p class="lede">My library of case studies. Select one to read!</p>
		</header>

		<section class="shelf-wrap" aria-labelledby="shelf-heading">
			<h2 id="shelf-heading" class="sr-only">Case studies on the shelf</h2>
			<div class="shelf" data-shelf>
				<img
					class="shelf__photo"
					src="/images/shelf-case-studies.webp"
					alt=""
					width="1672"
					height="941"
					fetchpriority="high"
				/>
				<ul>
					{
						books.map((book) => (
							<li>
								<a class="book" href={`/work/${book.slug}`} data-book={book.slug} style={book.spot}>
									<span class="book__tip" aria-hidden="true">
										<span class="book__tip-num">{book.numeral}</span>
										{book.title}
									</span>
									<span class="sr-only">
										{book.title}: {book.subtitle}
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<!-- A brass plaque on the shelf's edge under each book. -->
				{
					books.map((book) => (
						<a
							class="placard"
							href={`/work/${book.slug}`}
							tabindex="-1"
							aria-hidden="true"
							data-placard={book.slug}
							style={book.plaque}
						>
							<span class="placard__title">{book.study.title}</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="page index" aria-labelledby="index-heading">
			<p class="ornament" aria-hidden="true">❦</p>
			<h2 id="index-heading" class="index-title">Index</h2>
			<ol class="entries">
				{
					books.map((book) => (
						<li class="entry">
							<span class="entry__num">{book.numeral}</span>
							<div class="entry__body">
								<h3 class="entry__title">
									<a href={`/work/${book.slug}`}>{book.study.title}</a>
								</h3>
								<p class="entry__summary">{book.study.summary}</p>
								<p class="entry__meta small-caps">
									{book.study.meta.type} · {book.study.meta.client}
								</p>
							</div>
							<img class="entry__cover" src={book.study.cover} alt="" loading="lazy" />
						</li>
					))
				}
			</ol>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	/* Taking a book down: the shelf draws in on it, then the page turns to
	   the case study. */
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-book]')) {
		link.addEventListener('click', (event) => {
			if (reduce || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
			event.preventDefault();
			const shelf = link.closest<HTMLElement>('[data-shelf]')!;
			for (const prop of ['--ox', '--oy']) shelf.style.setProperty(prop, link.style.getPropertyValue(prop));
			shelf.classList.add('is-taken');
			window.setTimeout(() => window.location.assign(link.href), 850);
		});
	}
	// A plaque takes down the book above it.
	for (const plaque of document.querySelectorAll<HTMLAnchorElement>('[data-placard]')) {
		const book = document.querySelector<HTMLAnchorElement>(`[data-book="${plaque.dataset.placard}"]`);
		plaque.addEventListener('click', (event) => {
			if (!book || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
			event.preventDefault();
			book.click();
		});
		// Light the plaque while its book is under the hand, and the reverse.
		for (const [from, to] of [[book, plaque], [plaque, book]]) {
			from?.addEventListener('pointerenter', () => to?.classList.add('is-lit'));
			from?.addEventListener('pointerleave', () => to?.classList.remove('is-lit'));
		}
	}
	// Back from a case study via bfcache: put the book back on the shelf.
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) document.querySelectorAll('.is-taken').forEach((el) => el.classList.remove('is-taken'));
	});
</script>

<style>
	/* Arriving from the study's shelf zoom: the shelf comes up to meet you. */
	.work {
		animation: arrive 900ms var(--ease-page) both;
	}

	@keyframes arrive {
		from {
			opacity: 0;
			transform: scale(1.04);
			filter: blur(3px);
		}
	}

	.intro {
		padding-block: clamp(48px, 7vw, 96px) clamp(24px, 4vw, 48px);
		text-align: center;
	}

	.kicker {
		color: var(--color-burgundy);
	}

	.title {
		font-family: var(--font-display);
		font-size: var(--fs-display);
		font-weight: 600;
		font-style: italic;
		line-height: 1;
	}

	.lede {
		max-width: 40ch;
		margin: 18px auto 0;
		font-size: var(--fs-lg);
		font-style: italic;
		color: var(--color-ink-soft);
	}

	/* The shelf ---------------------------------------------------- */

	.shelf-wrap {
		max-width: 1100px;
		margin: clamp(16px, 3vw, 40px) auto 0;
		padding-inline: var(--gutter);
	}

	.shelf {
		position: relative;
		overflow: hidden;
		border-radius: 4px;
		box-shadow: 0 24px 48px -20px rgba(31, 20, 13, 0.7);
	}

	.shelf__photo {
		display: block;
		width: 100%;
		height: auto;
		transform-origin: var(--ox) var(--oy);
		transition:
			transform 850ms var(--ease-page),
			filter 850ms ease;
	}

	/* Taken down: the shelf draws in on the chosen book. */
	.shelf.is-taken .shelf__photo {
		transform: scale(1.8);
		filter: brightness(1.15);
	}

	.shelf.is-taken .book {
		visibility: hidden;
	}

	.book {
		position: absolute;
		border-radius: 4px;
	}

	/* A warm bloom over the book while it's under the hand. */
	.book::before {
		content: '';
		position: absolute;
		inset: -12% -40%;
		background: radial-gradient(ellipse at center, rgba(255, 196, 120, 0.3), transparent 65%);
		mix-blend-mode: screen;
		opacity: 0;
		transition: opacity 400ms ease;
		pointer-events: none;
	}

	.book:hover::before,
	.book.is-lit::before,
	.book:focus-visible::before {
		opacity: 1;
	}

	.book:focus-visible {
		outline: 2px solid var(--color-brass-light);
		outline-offset: 4px;
	}

	/* Title tag above the book while it's under the hand. */
	.book__tip {
		position: absolute;
		left: 50%;
		bottom: calc(100% + 12px);
		z-index: 2;
		padding: 5px 12px 6px;
		border: 1px solid rgba(220, 194, 140, 0.7);
		border-radius: 999px;
		background: rgba(31, 20, 13, 0.88);
		color: var(--color-ivory);
		font-size: 15px;
		font-style: italic;
		white-space: nowrap;
		opacity: 0;
		transform: translate(-50%, 4px);
		transition:
			opacity 300ms ease,
			transform 300ms ease;
		pointer-events: none;
	}

	.book:hover .book__tip,
	.book:focus-visible .book__tip {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.book__tip-num {
		margin-right: 6px;
		color: var(--color-brass-light);
	}

	/* Plaques: brass, set into the shelf's front edge (88-95% down the
	   photo) under each book. Sized off the shelf so they scale with it. */
	.shelf {
		container-type: inline-size;
	}

	.placard {
		position: absolute;
		top: 88.4%;
		height: 6.2%;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-inline: 1.3cqw;
		/* Cut corners, like the shelf's old "Case Studies" plaque. */
		clip-path: polygon(
			0.6cqw 0, calc(100% - 0.6cqw) 0, 100% 0.6cqw, 100% calc(100% - 0.6cqw),
			calc(100% - 0.6cqw) 100%, 0.6cqw 100%, 0 calc(100% - 0.6cqw), 0 0.6cqw
		);
		background:
			radial-gradient(ellipse at 50% 0%, rgba(255, 246, 214, 0.55), transparent 60%),
			linear-gradient(#e2c785, #c9a663 45%, #a8854c);
		box-shadow:
			inset 0 0 0 1px rgba(110, 80, 40, 0.75),
			inset 0 0 0 2px rgba(255, 236, 190, 0.45);
		color: #2a1c13;
		text-align: center;
		transform: translateX(-50%);
		transition: filter 400ms ease;
	}

	/* The little four-point stars at either end. */
	.placard::before,
	.placard::after {
		content: '✦';
		position: absolute;
		top: 50%;
		font-size: 0.6cqw;
		color: #4a3424;
		transform: translateY(-50%);
	}

	.placard::before {
		left: 0.55cqw;
	}

	.placard::after {
		right: 0.55cqw;
	}

	.placard:hover,
	.placard.is-lit {
		filter: brightness(1.15) drop-shadow(0 0 6px rgba(255, 200, 120, 0.6));
	}

	.placard__title {
		font-family: var(--font-body);
		font-size: 1.2cqw;
		font-weight: 600;
		line-height: 1.1;
		text-wrap: balance;
		text-shadow: 0 1px 0 rgba(255, 240, 200, 0.5);
	}

	/* Phone-sized shelf: drop the stars and let the title fill the plaque. */
	@container (max-width: 700px) {
		.placard {
			padding-inline: 0.5cqw;
		}

		.placard::before,
		.placard::after {
			display: none;
		}

		.placard__title {
			font-size: 1.7cqw;
			line-height: 1;
		}
	}

	.shelf.is-taken .placard {
		visibility: hidden;
	}

	/* Index -------------------------------------------------------- */

	.index {
		max-width: calc(980px + 2 * var(--gutter));
		padding-block: clamp(96px, 10vw, 140px) clamp(64px, 8vw, 110px);
	}

	.index-title {
		margin: 12px 0 36px;
		text-align: center;
		font-family: var(--font-display);
		font-size: var(--fs-h2);
		font-weight: 600;
		letter-spacing: 0.2em;
		font-variant: small-caps;
	}

	.entries {
		border-top: var(--rule-strong);
	}

	.entry {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) 180px;
		gap: clamp(16px, 3vw, 40px);
		align-items: center;
		padding-block: 28px;
		border-bottom: var(--rule-faint);
	}

	.entry__num {
		font-family: var(--font-display);
		font-size: 36px;
		font-style: italic;
		color: var(--color-brass);
	}

	.entry__title {
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		font-weight: 600;
		line-height: 1.15;
	}

	.entry__title a {
		background: linear-gradient(var(--color-burgundy), var(--color-burgundy)) 0 100% / 0 1px no-repeat;
		transition: background-size 500ms var(--ease-page), color 300ms ease;
	}

	.entry__title a:hover,
	.entry__title a:focus-visible {
		color: var(--color-burgundy);
		background-size: 100% 1px;
	}

	.entry__summary {
		margin-top: 6px;
		font-style: italic;
		color: var(--color-ink-soft);
	}

	.entry__meta {
		margin-top: 8px;
		font-size: 15px;
		color: var(--color-ink-soft);
	}

	.entry__cover {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border: 6px solid var(--color-ivory);
		box-shadow:
			0 0 0 1px rgba(42, 28, 19, 0.15),
			0 10px 24px -10px rgba(42, 28, 19, 0.5);
		transform: rotate(1.5deg);
	}

	@media (max-width: 720px) {
		.entry {
			grid-template-columns: 40px minmax(0, 1fr);
		}

		.entry__cover {
			grid-column: 2;
			max-width: 260px;
		}
	}
</style>
