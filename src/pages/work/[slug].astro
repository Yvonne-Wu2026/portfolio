---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import NumberedSection from '../../components/NumberedSection.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import MediaBlock from '../../components/MediaBlock.astro';
import ImageBand from '../../components/ImageBand.astro';
import ImageRow from '../../components/ImageRow.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import CompareBlock from '../../components/CompareBlock.astro';
import CaseStudyNav from '../../components/CaseStudyNav.astro';
import { caseStudies } from '../../data/caseStudies';

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;

/* The next study in the list, wrapping round; undefined if this is the only one. */
const current = caseStudies.findIndex((entry) => entry.slug === study.slug);
const next =
	caseStudies.length > 1
		? caseStudies[(current + 1) % caseStudies.length]
		: undefined;

const quickInfo = [
	{ label: 'ROLE', value: study.meta.role },
	{ label: 'TYPE', value: study.meta.type },
	{ label: 'CLIENT', value: study.meta.client },
	{ label: 'DESIGN TOOLS', value: study.meta.tools },
];
---

<Layout title={`${study.title} — Yvonne Wu`} description={study.summary}>
	<Nav />

	<main id="main">
		<!-- Title page: kicker, title, summary, then the colophon of facts. -->
		<header class="page title-section">
			<a class="back" href="/work"><span aria-hidden="true">←</span> Back to the shelf</a>
			<p class="small-caps kicker">A case study</p>
			<h1 class="title">{study.title}</h1>
			<p class="summary">{study.summary}</p>
			<p class="ornament" aria-hidden="true">❦</p>
			<dl class="quick-info">
				{
					quickInfo.map((item) => (
						<div class="fact">
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</div>
					))
				}
			</dl>
			{study.cta && <div class="cta"><Button href={study.cta.href} label={study.cta.label} /></div>}
		</header>

		<!-- The hero, mounted like a plate in an old monograph. -->
		<figure class="plate">
			<div
				class:list={['hero-image', { 'hero-image--filled': study.hero?.src }]}
				style={[
					study.hero?.ratio && `aspect-ratio: ${study.hero.ratio};`,
					study.hero?.maxWidth && `max-width: ${study.hero.maxWidth};`,
				]
					.filter(Boolean)
					.join(' ')}
			>
				{study.hero?.src && <img src={study.hero.src} alt={study.hero.alt ?? ''} />}
			</div>
			<figcaption class="small-caps">Plate I · {study.title}</figcaption>
		</figure>

		{
			study.sections.map((section) => (
				<NumberedSection
					number={section.number}
					title={section.title}
					subtitle={section.subtitle}
					bodyHtml={section.bodyHtml}
					variant={section.variant}
					tightBottom={section.tightBottom}
				>
					{section.blocks?.map((block) => {
						if (block.type === 'cards') {
							return (
								<div class="problem-grid" style={`--count: ${block.cards.length};`}>
									{block.cards.map((card) => (
										<ProblemCard title={card.title} bodyHtml={card.bodyHtml} />
									))}
								</div>
							);
						}
						if (block.type === 'media') {
							return (
								<MediaBlock
									src={block.src}
									alt={block.alt}
									bodyHtml={block.bodyHtml}
									reverse={block.reverse}
								/>
							);
						}
						if (block.type === 'flow') {
							return <FlowDiagram steps={block.steps} />;
						}
						if (block.type === 'text') {
							return <div class="prose" set:html={block.bodyHtml} />;
						}
						if (block.type === 'compare') {
							return <CompareBlock before={block.before} after={block.after} />;
						}
						if (block.type === 'imageRow') {
							return <ImageRow images={block.images} ratio={block.ratio} />;
						}
						return (
							<ImageBand
								src={block.src}
								alt={block.alt}
								ratio={block.ratio}
								caption={block.caption}
								captionAlign={block.captionAlign}
								href={block.href}
								maxWidth={block.maxWidth}
								objectPosition={block.objectPosition}
								srcWebm={block.srcWebm}
							/>
						);
					})}
				</NumberedSection>
			))
		}

		<CaseStudyNav next={next && { title: next.title, slug: next.slug }} />
	</main>

	<Footer />
</Layout>

<style>
	.title-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		max-width: calc(1000px + 2 * var(--gutter));
		padding-block: clamp(36px, 6vw, 80px) clamp(24px, 4vw, 48px);
		text-align: center;
	}

	.back {
		align-self: flex-start;
		margin-bottom: clamp(16px, 3vw, 36px);
		font-size: 17px;
		font-style: italic;
		color: var(--color-ink-soft);
	}

	.back:hover {
		color: var(--color-burgundy);
	}

	.kicker {
		color: var(--color-burgundy);
	}

	.title {
		font-family: var(--font-display);
		font-size: var(--fs-display);
		font-weight: 600;
		font-style: italic;
		line-height: 1;
		text-wrap: balance;
	}

	.summary {
		max-width: 48ch;
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		font-weight: 500;
		line-height: 1.25;
		color: var(--color-ink-soft);
		text-wrap: balance;
	}

	.title-section .ornament {
		width: 100%;
		margin-block: 10px;
	}

	/* Facts set as a two-column colophon with brass hairlines. */
	.quick-info {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		width: 100%;
		border-top: var(--rule-brass);
		text-align: left;
	}

	.fact {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 14px 18px;
		border-bottom: var(--rule-brass);
	}

	.fact:nth-child(odd) {
		border-right: var(--rule-brass);
	}

	.fact dt {
		font-size: 15px;
		font-variant: all-small-caps;
		letter-spacing: 0.16em;
		color: var(--color-burgundy);
	}

	.fact dd {
		font-size: var(--fs-body);
		line-height: 1.4;
	}

	.cta {
		margin-top: 18px;
	}

	.plate {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		max-width: calc(1200px + 2 * var(--gutter));
		margin: 0 auto clamp(24px, 4vw, 56px);
		padding-inline: var(--gutter);
	}

	.plate figcaption {
		font-size: 15px;
		color: var(--color-ink-soft);
	}

	.hero-image {
		width: 100%;
		margin-inline: auto;
		aspect-ratio: 1440 / 847;
		padding: clamp(10px, 1.6vw, 22px);
		background-color: var(--color-card);
		box-shadow:
			0 0 0 1px rgba(176, 141, 87, 0.6),
			0 24px 50px -28px rgba(42, 28, 19, 0.6);
		overflow: hidden;
	}

	.hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Trim from the top of the arena photo, keeping the stats in frame. */
		object-position: bottom;
	}

	.problem-grid {
		display: grid;
		grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
		gap: clamp(16px, 2.5vw, 36px);
		align-items: stretch;
		padding: 10px;
	}

	@media (max-width: 900px) {
		.problem-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.quick-info {
			grid-template-columns: minmax(0, 1fr);
		}

		.fact:nth-child(odd) {
			border-right: 0;
		}
	}
</style>
