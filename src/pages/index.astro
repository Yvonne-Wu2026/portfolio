---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import Footer from '../components/Footer.astro';
import { caseStudies } from '../data/caseStudies';

/* Copy transcribed from Figma "Home" 31:1041. */
const intro = 'Hi, I am a UX designer based in Boston.';

const aboutHtml = `
	<p>Welcome! I am Yvonne, a current graduate student in Human Factors at Bentley University. I am balancing school with a full-time career in civil service.</p>
	<p>Outside of work and school, you’ll probably find me hanging out with my cats, searching for a new noodle soup recipe to recreate, doing Pilates, browsing eBay for my next film camera, or getting lost in a good book.</p>
	<p>I am always learning more about UX design, whether that be trying a new Figma tool or plugin, vibe coding a new idea, or exploring AI tools and platforms. At the heart of it all, I’m interested in understanding people: how they think, what they need, and what gets in their way. I believe good UX starts with putting people first and using technology thoughtfully to create experiences that feel intuitive, useful, and genuinely human.</p>
`;

const contactBody = 'Feel free to reach out to me via email, or connect with me on LinkedIn!';
const email = 'yvonnewu.designs@gmail.com';
const linkedin = 'https://www.linkedin.com/in/yvonne-wu-54b7a335b/';
---

<Layout>
	<Nav />

	<main>
		<!-- Figma: "Top section" 31:1093 -->
		<Hero />
		<div class="rule rule--strong"></div>
		<div class="page intro">
			<p>{intro}</p>
		</div>

		<!-- Figma: "Work section homepage" 64:821 -->
		<section class="block" id="work">
			<div class="rule"></div>
			<div class="page">
				<h2 class="section-heading">Work</h2>
				<div class="work-grid">
					{
						caseStudies.map((study) => (
							<WorkCard
								name={study.title}
								href={`/work/${study.slug}`}
								cover={study.cover}
								coverAlt={study.coverAlt}
								coverPosition={study.coverPosition}
							/>
						))
					}
				</div>
			</div>
		</section>

		<!-- Figma: "About section" 31:1143 -->
		<section class="block" id="about">
			<div class="rule"></div>
			<div class="page split">
				<div class="split-text">
					<h2 class="section-heading">About</h2>
					<div class="prose prose--spaced" set:html={aboutHtml} />
				</div>
				<div class="about-photo">
					<img
						src="/images/about-portrait.webp"
						alt="Yvonne holding a grey British Shorthair cat"
						width="1148"
						height="1228"
						loading="lazy"
					/>
				</div>
			</div>
		</section>

		<!-- Figma: "Contact Section" 31:1154 -->
		<section class="block" id="contact">
			<div class="rule"></div>
			<div class="page">
				<h2 class="section-heading">Contact</h2>
				<p class="body-text contact-intro">{contactBody}</p>
				<dl class="contact-grid">
					<dt>EMAIL</dt>
					<dd><a href={`mailto:${email}`}>{email}</a></dd>
					<dt>LinkedIn</dt>
					<dd>
						<a class="link-accent" href={linkedin} target="_blank" rel="noopener noreferrer">
							LinkedIn Profile
						</a>
					</dd>
				</dl>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.intro {
		padding-block: clamp(24px, 3vw, 37px);
		font-size: clamp(16px, 1.5vw, 20px);
	}

	.block {
		display: flex;
		flex-direction: column;
		gap: 50px;
		padding-block: clamp(28px, 3.5vw, 37px);
	}

	.block .page {
		display: flex;
		flex-direction: column;
		gap: clamp(32px, 4vw, 53px);
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(24px, 6vw, 150px);
	}

	.split {
		display: flex;
		flex-direction: row;
		/* Figma 31:1143: text anchored left, photo at the right gutter, centred against it. */
		align-items: center;
		justify-content: space-between;
		gap: clamp(24px, 4vw, 64px);
	}

	.split-text {
		display: flex;
		flex-direction: column;
		gap: 30px;
		max-width: 730px;
	}

	.about-photo {
		flex: 0 0 auto;
		width: clamp(180px, 25vw, 356px);
		aspect-ratio: 356 / 372;
		border-radius: clamp(48px, 6vw, 85px);
		overflow: hidden;
	}

	.about-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.contact-intro {
		max-width: 1296px;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
		font-size: var(--fs-lg);
		line-height: 1.3;
	}

	.contact-grid dt,
	.contact-grid dd {
		padding: 10px;
	}

	.contact-grid dd {
		text-align: right;
	}

	.contact-grid a:hover {
		text-decoration: underline;
	}

	.link-accent {
		color: var(--color-link);
		text-decoration: underline;
	}

	@media (max-width: 860px) {
		.work-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.split {
			flex-direction: column;
			align-items: flex-start;
		}

		.about-photo {
			width: 100%;
			max-width: 356px;
			align-self: center;
		}
	}
</style>

<style is:global>
	/* Roomier paragraph breaks for the About copy. */
	.prose--spaced > * + * {
		margin-top: 1.7em;
	}
</style>
