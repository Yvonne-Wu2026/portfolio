---
import Layout from '../layouts/Layout.astro';
import PhotoStudy from '../components/study/PhotoStudy';
import { chapters, shelfBooks } from '../data/library';
---

<Layout
	title="Yvonne Wu — UX & UI Designer"
	description="Step into Yvonne Wu's study: a UX and UI design portfolio. Open the book to navigate, take a case study from the shelf, and adjust the lamp."
	bodyClass="study-body"
>
	<!-- The study sizes itself to the window, so it renders client-side. Until
	     it mounts, the same loading card the island shows stands in for it. -->
	<PhotoStudy client:only="react">
		<div slot="fallback" class="study-fallback" role="status">
			<span class="study-fallback__flame"></span>
			<p>Lighting the lamp…</p>
		</div>
	</PhotoStudy>

	<noscript>
		<nav class="noscript-nav" aria-label="Primary">
			<h1>Yvonne Wu — UX &amp; UI Designer</h1>
			<ul>
				{chapters.map((chapter) => <li><a href={chapter.href}>{chapter.label}</a></li>)}
				{shelfBooks.map((book) => <li><a href={`/work/${book.slug}`}>{book.title}</a></li>)}
			</ul>
		</nav>
	</noscript>
</Layout>

<style is:global>
	.study-body {
		background: #1f140d;
		overflow: hidden;
	}
</style>

<style>
	.study-fallback {
		position: fixed;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 14px;
		background:
			radial-gradient(ellipse at 50% 40%, rgba(217, 162, 76, 0.18), transparent 60%),
			var(--color-espresso);
		color: var(--color-brass-light);
		font-family: var(--font-display);
		font-size: 22px;
		font-style: italic;
	}

	.study-fallback__flame {
		width: 10px;
		height: 16px;
		border-radius: 50% 50% 45% 45% / 65% 65% 35% 35%;
		background: radial-gradient(circle at 50% 70%, #fff3d0, var(--color-amber) 60%, transparent 75%);
		box-shadow: 0 0 30px 10px rgba(217, 162, 76, 0.35);
	}

	.noscript-nav {
		position: fixed;
		inset: 0;
		z-index: 100;
		padding: 48px 24px;
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.noscript-nav h1 {
		font-family: var(--font-display);
		font-size: 40px;
		margin-bottom: 24px;
	}

	.noscript-nav a {
		font-size: 22px;
		text-decoration: underline;
	}
</style>
