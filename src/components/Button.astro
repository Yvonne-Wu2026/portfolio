---
/* Figma: "Explore ptype button" 111:1263 — restyled as an espresso pill with a brass edge.
   href is optional: the PawTrainer instance in Figma has no link attached yet,
   so it renders as a non-interactive pill until a URL is supplied. */
interface Props {
	href?: string;
	label?: string;
}

const { href, label = 'Explore Prototype' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
	class:list={['button', { 'button--unlinked': !href }]}
	href={href}
	target={href ? '_blank' : undefined}
	rel={href ? 'noopener noreferrer' : undefined}
	aria-disabled={href ? undefined : 'true'}
>
	<span>{label}</span>
	<span class="arrow" aria-hidden="true"></span>
</Tag>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 10px clamp(16px, 1.7vw, 22px);
		border-radius: 100px;
		border: 1px solid var(--color-brass);
		background-color: var(--color-espresso);
		color: var(--color-ivory);
		font-size: clamp(18px, 1.5vw, 21px);
		font-style: italic;
		font-weight: 500;
		line-height: 1.2;
		white-space: nowrap;
		transition:
			filter 150ms ease,
			transform 150ms ease;
	}

	a.button:hover,
	a.button:focus-visible {
		box-shadow: 0 0 0 3px rgba(176, 141, 87, 0.3);
		transform: translateY(-1px);
	}

	.button--unlinked {
		cursor: default;
	}

	.arrow {
		width: clamp(18px, 1.9vw, 24px);
		height: clamp(18px, 1.9vw, 24px);
		flex: 0 0 auto;
		/* The icon file is filled with the old brown, so use it as a mask and
		   paint it in the label colour instead. */
		background-color: currentColor;
		-webkit-mask: url('/icons/arrow-right.svg') center / contain no-repeat;
		mask: url('/icons/arrow-right.svg') center / contain no-repeat;
		/* Figma mirrors the mi:arrow-left asset to point right. */
		transform: scaleX(-1);
	}
</style>
