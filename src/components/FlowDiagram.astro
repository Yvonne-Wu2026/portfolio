---
/* A row of steps joined by arrows, stacking on narrow screens. Each step shows
   either an icon (a conceptual flow) or a screenshot (a walkthrough). */
import type { FlowStep } from '../data/caseStudies';

interface Props {
	steps: FlowStep[];
}

const { steps } = Astro.props;

const tones = ['butter', 'sky', 'cream'];
---

<ol class="flow">
	{
		steps.map((step, index) => (
			<li class:list={['step', `step--${tones[index % tones.length]}`]}>
				{step.label && <p class="label">{step.label}</p>}
				{!step.image && (
					<span class="icon" aria-hidden="true">
						{step.icon === 'activity' && (
							<svg viewBox="0 0 24 24">
								<rect x="4" y="11" width="3.5" height="9" rx="1" />
								<rect x="10.25" y="5" width="3.5" height="15" rx="1" />
								<rect x="16.5" y="8" width="3.5" height="12" rx="1" />
							</svg>
						)}
						{step.icon === 'insight' && (
							<svg viewBox="0 0 24 24" class="stroke">
								<path d="M12 3.5a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2v.5h5v-.5c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3.5Z" />
								<path d="M9.75 20.5h4.5" />
							</svg>
						)}
						{step.icon === 'guidance' && (
							<svg viewBox="0 0 24 24" class="stroke">
								<path d="M20 11.5c0 4.1-3.6 7.5-8 7.5-1.1 0-2.2-.2-3.1-.6L4 19.5l1.3-3.6A7.2 7.2 0 0 1 4 11.5C4 7.4 7.6 4 12 4s8 3.4 8 7.5Z" />
							</svg>
						)}
					</span>
				)}
				<h3 class="title">{step.title}</h3>
				<p class="body">{step.body}</p>
				{step.image && (
					<div class="shot">
						<img
							src={step.image.src}
							alt={step.image.alt}
							style={`aspect-ratio: ${step.image.ratio};`}
							loading="lazy"
						/>
					</div>
				)}
			</li>
		))
	}
</ol>

<style>
	.flow {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(36px, 4vw, 56px);
		padding: 10px;
		list-style: none;
	}

	.step {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: clamp(22px, 2.2vw, 30px);
		border-radius: 28px;
		color: #1f4072;
		/* Same lift as the problem cards. */
		box-shadow:
			0 0 0 1px rgba(31, 64, 114, 0.08),
			0 2px 4px rgba(31, 64, 114, 0.06),
			0 12px 28px -10px rgba(31, 64, 114, 0.22);
	}

	.step--butter {
		background-color: var(--color-butter);
	}

	.step--sky {
		background-color: var(--color-sky);
	}

	.step--cream {
		background-color: var(--color-cream);
	}

	/* Arrow in the gap after every step but the last. */
	.step:not(:last-child)::after {
		content: '→';
		position: absolute;
		top: 50%;
		left: 100%;
		width: clamp(36px, 4vw, 56px);
		transform: translateY(-50%);
		text-align: center;
		font-size: var(--fs-lg);
		line-height: 1;
		color: var(--color-accent-2);
	}

	.icon {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		margin-bottom: 6px;
		border-radius: 14px;
		background-color: rgba(255, 255, 255, 0.7);
	}

	.icon svg {
		width: 24px;
		height: 24px;
		fill: currentColor;
	}

	.icon svg.stroke {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.title {
		font-family: var(--font-playfair);
		font-size: var(--fs-body);
		font-weight: 700;
		line-height: 1.3;
	}

	.body {
		font-size: var(--fs-body);
		line-height: 1.4;
	}

	.label {
		font-size: var(--fs-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* Pinned to the card's foot, so screenshots line up whatever the copy length. */
	.shot {
		margin-top: auto;
		padding-top: 12px;
	}

	.shot img {
		display: block;
		width: 100%;
		border-radius: 18px;
		object-fit: cover;
		object-position: top;
	}

	@media (max-width: 900px) {
		.flow {
			grid-template-columns: minmax(0, 1fr);
		}

		/* A full-width card would blow the screenshot up past its real size. */
		.shot img {
			max-width: 389px;
			margin-inline: auto;
		}

		.step:not(:last-child)::after {
			content: '↓';
			top: 100%;
			left: 50%;
			width: auto;
			height: clamp(36px, 4vw, 56px);
			display: grid;
			place-items: center;
			transform: translateX(-50%);
		}
	}
</style>
