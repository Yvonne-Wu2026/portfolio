---
/* Figma: "Problem card" 19:887, restyled for the library theme as a ruled index card. */
interface Props {
	title: string;
	bodyHtml: string;
}

const { title, bodyHtml } = Astro.props;
---

<article class="card">
	<h3 class="title">{title}</h3>
	<div class="prose body" set:html={bodyHtml} />
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 30px 28px 28px;
		border-radius: 2px;
		/* An index card: a burgundy head rule over faint ruled lines. */
		background:
			linear-gradient(var(--color-burgundy), var(--color-burgundy)) 0 64px / 100% 1px no-repeat,
			repeating-linear-gradient(transparent 0 31px, rgba(42, 28, 19, 0.07) 31px 32px) 0 64px / 100% 100% no-repeat,
			var(--color-ivory);
		color: var(--color-ink);
		box-shadow:
			0 0 0 1px rgba(176, 141, 87, 0.45),
			0 12px 26px -14px rgba(42, 28, 19, 0.45);
	}

	.title {
		min-height: 2.6em;
		font-family: var(--font-display);
		font-size: var(--fs-lg);
		font-weight: 600;
		line-height: 1.15;
	}

	/* Sit the text on the card's 32px ruled lines. */
	.body {
		padding: 0;
		line-height: 32px;
	}
</style>
