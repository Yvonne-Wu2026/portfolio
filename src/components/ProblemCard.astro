---
/* Figma: "Problem card" 19:887, restyled: borderless butter card with navy text. */
interface Props {
	title: string;
	bodyHtml: string;
}

const { title, bodyHtml } = Astro.props;
---

<article class="card">
	<h3 class="title">{title}</h3>
	<div class="prose body" set:html={bodyHtml} />
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 30px;
		border-radius: 36px;
		background-color: var(--color-butter);
		color: #1f4072;
		/* A navy-tinted hairline edge plus a soft lift, so it doesn't sit flat. */
		box-shadow:
			0 0 0 1px rgba(31, 64, 114, 0.08),
			0 2px 4px rgba(31, 64, 114, 0.06),
			0 12px 28px -10px rgba(31, 64, 114, 0.22);
	}

	.title {
		font-family: var(--font-playfair);
		font-size: var(--fs-body);
		font-weight: 700;
		line-height: 1.3;
	}

	.body {
		padding: 0;
	}
</style>
