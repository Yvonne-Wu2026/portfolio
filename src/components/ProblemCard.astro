---
/* Figma: "Problem card" 19:887 — Accent light fill, Accent 2 border and text. */
interface Props {
	title: string;
	bodyHtml: string;
}

const { title, bodyHtml } = Astro.props;
---

<article class="card">
	<h3 class="title">{title}</h3>
	<div class="prose body" set:html={bodyHtml} />
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 30px;
		border: 1px solid var(--color-accent-2);
		border-radius: 36px;
		background-color: var(--color-accent-light);
		color: var(--color-accent-2);
	}

	.title {
		font-size: var(--fs-body);
		font-weight: 700;
		line-height: 1.3;
	}

	.body {
		padding: 0;
	}
</style>
