---
/* Figma: "line sep section" 60:653 plus the section header/body pattern.
   variant="detail" is the "Solution details" block — a 32px bold heading
   with no numbered rule. */
interface Props {
	number?: string;
	title: string;
	subtitle?: string;
	bodyHtml?: string;
	variant?: 'section' | 'detail';
	tightBottom?: boolean;
	id?: string;
}

const { number, title, subtitle, bodyHtml, variant = 'section', tightBottom = false, id } = Astro.props;
---

<section class:list={['sec', `sec--${variant}`, { 'sec--tight-bottom': tightBottom }]} id={id}>
	{
		number && (
			<div class="sep">
				<span class="number">{number}</span>
				<span class="line" />
			</div>
		)
	}
	<div class="page content">
		<h2 class:list={['heading', `heading--${variant}`]}>{title}</h2>
		{subtitle && <p class="subtitle">{subtitle}</p>}
		{bodyHtml && <div class="prose" set:html={bodyHtml} />}
		<slot />
	</div>
</section>

<style>
	.sec {
		display: flex;
		flex-direction: column;
		gap: clamp(40px, 5.5vw, 75px);
		/* Scales with the gap below the rule so both sides stay balanced. */
		padding-block: clamp(28px, 3.5vw, 50px);
	}

	.sec--detail {
		gap: 0;
		padding-block: clamp(24px, 3vw, 50px);
	}

	.sec--tight-bottom {
		padding-bottom: 10px;
	}

	.sep {
		display: flex;
		align-items: center;
		gap: 20px;
		width: 100%;
		max-width: var(--rule-max);
		margin-inline: auto;
		/* No extra space above: the flanking section padding already supplies it. */
		margin-block: 0 20px;
		padding-inline: var(--gutter);
	}

	/* Set like a chapter mark: "№ 01" in brass, then a hairline. */
	.number {
		font-family: var(--font-display);
		font-size: clamp(20px, 1.8vw, 26px);
		font-style: italic;
		font-weight: 600;
		color: var(--color-brass);
		line-height: 1;
	}

	.number::before {
		content: '№ ';
		font-style: normal;
		font-size: 0.8em;
	}

	.line {
		flex: 1 1 0;
		min-width: 0;
		border-top: var(--rule-brass);
	}

	.sep,
	.content {
		max-width: calc(1120px + 2 * var(--gutter));
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	/* Headings and text share one centred reading column; blocks run wider. */
	.content > .heading,
	.content > .subtitle {
		width: 100%;
		max-width: var(--measure);
		margin-inline: auto;
	}

	/* Sub-sections sit tighter: the heading belongs with its body. */
	.sec--detail .content {
		gap: 6px;
	}

	.heading {
		font-family: var(--font-display);
		font-weight: 600;
		line-height: 1.08;
	}

	.heading--section {
		font-size: var(--fs-h2);
	}

	.subtitle {
		/* Pulled up against the heading, and the body up against it, out of the 30px gap. */
		margin-block: -18px -14px;
		font-family: var(--font-display);
		font-size: clamp(21px, 1.8vw, 28px);
		font-style: italic;
		line-height: 1.3;
		color: var(--color-accent-2);
	}

	.heading--detail {
		font-size: clamp(22px, 2.3vw, 32px);
		padding: 10px;
	}

	/* Detail headings carry 10px padding and a 6px gap, so the subtitle follows suit. */
	.sec--detail .subtitle {
		margin-block: -8px 4px;
		padding-inline: 10px;
	}
</style>

<style is:global>
	/* Rich text transcribed from Figma (inline bold/italic, links, lists). */
	.prose {
		padding: 10px;
		font-size: var(--fs-body);
		line-height: 1.65;
		width: 100%;
		max-width: var(--measure);
		margin-inline: auto;
	}

	.prose > * + * {
		margin-top: 1em;
	}

	.prose strong {
		font-weight: 700;
	}

	/* Small-caps run-in labels inside a section (e.g. "The challenge"). */
	.prose h3 {
		margin-top: 1.8em;
		font-variant: all-small-caps;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 0.14em;
		line-height: 1.3;
		color: var(--color-burgundy);
	}

	.prose > h3:first-child {
		margin-top: 0;
	}

	.prose h3 + * {
		margin-top: 0.35em;
	}

	/* A reference list: a step below body copy. */
	.prose .sources {
		font-size: var(--fs-sm);
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.prose em {
		font-style: italic;
	}

	.prose ul {
		list-style: disc;
		padding-left: 36px;
	}

	.prose ul > li + li {
		margin-top: 0.35em;
	}

	.prose blockquote {
		padding-left: 24px;
		border-left: 3px solid var(--color-accent-1);
		font-style: italic;
	}

	.prose blockquote cite {
		display: block;
		margin-top: 0.35em;
		font-size: var(--fs-sm);
		font-style: normal;
		color: var(--color-accent-2);
	}

	/* A parchment slip with a brass edge, set apart from the running text. */
	.prose .callout {
		padding: 18px 24px;
		border-radius: 2px;
		border-left: 3px solid var(--color-brass);
		background: var(--paper-grain), #e9dcbf;
		color: var(--color-ink);
		box-shadow: 0 10px 22px -16px rgba(42, 28, 19, 0.5);
	}

	/* A larger aside that frames context, such as an app overview, apart from the body. */
	.prose .callout--panel {
		max-width: 90ch;
		margin-inline: auto;
		padding: clamp(24px, 2.8vw, 40px);
		border-left: 0;
		box-shadow:
			0 0 0 1px rgba(176, 141, 87, 0.7),
			0 0 0 6px #e9dcbf,
			0 0 0 7px rgba(176, 141, 87, 0.45),
			0 18px 30px -18px rgba(42, 28, 19, 0.5);
	}

	/* An image beside the callout text, stacking on narrow screens. */
	/* The prose column hugs the left edge; let a panel's wrapper span the
	   section so the panel itself can sit centred. */
	.prose:has(> .callout--panel) {
		max-width: none;
	}

	.prose .callout--media {
		display: grid;
		grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
		gap: clamp(20px, 3vw, 40px);
		align-items: center;
	}

	.prose .callout--media > img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 2px;
		background-color: var(--color-ivory);
	}

	.prose .callout--media > div > * + * {
		margin-top: 0.6em;
	}

	@media (max-width: 640px) {
		.prose .callout--media {
			grid-template-columns: minmax(0, 1fr);
		}

		.prose .callout--media > img {
			max-width: 200px;
		}
	}

	.prose .callout:not(.callout--media) > * + * {
		margin-top: 1em;
	}

	.prose .callout-label {
		font-variant: all-small-caps;
		font-size: 17px;
		letter-spacing: 0.14em;
		color: var(--color-burgundy);
	}

	.prose a {
		color: var(--color-link);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: rgba(111, 43, 42, 0.4);
		text-underline-offset: 3px;
	}

	.prose a:hover {
		opacity: 0.75;
	}

	.prose .tree {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: clamp(13px, 1.1vw, 20px);
		line-height: 1.5;
		white-space: pre;
		overflow-x: auto;
		max-width: 100%;
	}
</style>
