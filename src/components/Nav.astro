---
/* Header for the reading pages: the study's wordmark and contents, set like
   a running head. "Return to the study" always leads back to the 3D desk. */
import { chapters } from '../data/library';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="header" id="top">
	<a class="skip" href="#main">Skip to content</a>
	<nav class="page navbar" aria-label="Primary">
		<a class="wordmark" href="/">
			Yvonne Wu
			<span class="role">UX &amp; UI Designer</span>
		</a>
		<ol class="links">
			{
				chapters
					.filter((chapter) => chapter.href !== '/')
					.map((chapter) => (
						<li>
							<a class="link" href={chapter.href} aria-current={current(chapter.href) ? 'page' : undefined}>
								<span class="num">{chapter.number}</span>
								{chapter.label}
							</a>
						</li>
					))
			}
		</ol>
		<a class="return" href="/">
			<span aria-hidden="true">←</span> Return to the study
		</a>
	</nav>
</header>

<style>
	.header {
		position: relative;
		background:
			linear-gradient(rgba(31, 20, 13, 0.92), rgba(31, 20, 13, 0.97)),
			repeating-linear-gradient(178deg, rgba(0, 0, 0, 0.12) 0 3px, transparent 3px 13px),
			var(--color-walnut);
		color: var(--color-ivory);
		border-bottom: 1px solid rgba(176, 141, 87, 0.55);
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);
	}

	.skip {
		position: absolute;
		left: 16px;
		top: -60px;
		padding: 8px 14px;
		background: var(--color-ivory);
		color: var(--color-ink);
		z-index: 10;
	}

	.skip:focus {
		top: 12px;
	}

	.navbar {
		display: flex;
		align-items: center;
		gap: 16px clamp(16px, 3vw, 48px);
		min-height: 84px;
		padding-block: 14px;
	}

	.wordmark {
		display: flex;
		flex-direction: column;
		font-family: var(--font-display);
		font-size: clamp(24px, 2.2vw, 30px);
		font-weight: 600;
		line-height: 1;
	}

	.role {
		margin-top: 5px;
		font-family: var(--font-body);
		font-size: 13px;
		font-variant: all-small-caps;
		letter-spacing: 0.16em;
		color: var(--color-brass-light);
	}

	.links {
		display: flex;
		gap: clamp(12px, 2.4vw, 34px);
		margin-left: auto;
	}

	.link {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 6px;
		padding: 6px 0;
		font-size: var(--fs-nav);
		font-variant: all-small-caps;
		letter-spacing: 0.16em;
	}

	.num {
		font-size: 0.8em;
		color: var(--color-brass);
		letter-spacing: 0.05em;
	}

	.link::after {
		content: '';
		position: absolute;
		inset: auto 0 2px;
		height: 1px;
		background: var(--color-brass-light);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 400ms var(--ease-page);
	}

	.link:hover::after,
	.link[aria-current='page']::after {
		transform: scaleX(1);
	}

	.link[aria-current='page'] {
		color: var(--color-brass-light);
	}

	.return {
		padding-left: clamp(12px, 2.4vw, 34px);
		border-left: 1px solid rgba(220, 194, 140, 0.3);
		font-size: 16px;
		font-style: italic;
		color: var(--color-brass-light);
		white-space: nowrap;
	}

	.return:hover {
		color: var(--color-ivory);
	}

	.header :focus-visible {
		outline-color: var(--color-brass-light);
	}

	@media (max-width: 720px) {
		.navbar {
			flex-wrap: wrap;
		}

		.links {
			order: 3;
			width: 100%;
			margin-left: 0;
			justify-content: space-between;
		}

		.return {
			margin-left: auto;
			border-left: 0;
			padding-left: 0;
		}
	}
</style>
