---
/* Figma: "Header of every page" 5:77 — dark band, wordmark left, three text buttons right. */
const isHome = Astro.url.pathname === '/';
const to = (hash: string) => (isHome ? `#${hash}` : `/#${hash}`);

const links = [
	{ label: 'Work', href: to('work') },
	{ label: 'About', href: to('about') },
	// The contact block lives in the footer, which is on every page.
	{ label: 'Contact', href: '#contact' },
];
---

<header class="header" id="top">
	<nav class="page navbar" aria-label="Primary">
		<a class="wordmark" href="/">Yvonne Wu</a>
		<ul class="links">
			{
				links.map((link) => (
					<li>
						<a class="link" href={link.href}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	/* Figma 24:610 — 37px vertical padding around a 127px-tall menu row. */
	.header {
		background-color: var(--color-chrome);
		color: var(--color-butter);
		padding-block: clamp(16px, 2.6vw, 37px);
	}

	.navbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: clamp(64px, 8.8vw, 127px);
	}

	/* Figma I3:53;1:273 — inset 15px from the left and sitting ~10px below
	   the links' centre line; the top margin shifts the centred box down. */
	.wordmark {
		margin-top: clamp(0px, 1.3vw, 19px);
		padding-left: clamp(0px, 1.04vw, 15px);
		font-family: var(--font-playfair);
		font-size: clamp(28px, 3.33vw, 48px);
		font-weight: 500;
		line-height: 1.2;
		white-space: nowrap;
	}

	.links {
		display: flex;
		align-items: center;
		gap: clamp(2px, 1.25vw, 18px);
	}

	.link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 10px clamp(8px, 1.6vw, 22px);
		border-radius: 8px;
		font-family: var(--font-playfair);
		font-size: clamp(18px, 1.67vw, 24px);
		font-weight: 500;
		line-height: 1.2;
		white-space: nowrap;
		transition: background-color 150ms ease;
	}

	.link:hover {
		background-color: rgba(255, 243, 180, 0.12);
	}

	.header :focus-visible {
		outline-color: var(--color-butter);
	}

	@media (max-width: 520px) {
		.wordmark {
			font-size: 24px;
		}

		.link {
			font-size: 16px;
		}
	}
</style>
