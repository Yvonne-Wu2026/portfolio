---
/* Figma: "Homepage hero" 176:1343 — centred greeting and tagline, profile image at right. */
interface Props {
	image?: string;
	imageAlt?: string;
}

const {
	image = '/images/profile.webp',
	imageAlt = 'Yvonne Wu smiling, against a grey studio backdrop',
} = Astro.props;
---

<section class="hero page">
	<div class="text">
		<h1 class="greeting">Hi, I’m Yvonne!</h1>
		<p class="tagline">I design human-centered <br class="line-break" />digital experiences</p>
	</div>
	<div class="portrait">
		<img src={image} alt={imageAlt} width="843" height="1124" />
	</div>
</section>

<style>
	/* Figma 176:1343 — the hero hugs its content at 1178px (901 text + 277 image)
	   and centres in the column, rather than spreading to the full 1296px. The
	   vw coefficients below are set so every value reaches its designed size at
	   the same point, keeping the whole block in proportion as it scales. */
	.hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0;
		max-width: calc(1178px + 2 * var(--gutter));
		padding-block: clamp(48px, 7vw, 93px);
	}

	.text {
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		min-width: 0;
		/* Figma 176:1345 — 30px between the two lines, and the block is centred. */
		gap: clamp(16px, 2.55vw, 30px);
		text-align: center;
	}

	/* Figma 176:1346 — 86px. */
	.greeting {
		font-size: clamp(44px, 7.3vw, 86px);
		font-weight: 500;
		line-height: 1.2;
		color: color-mix(in srgb, var(--color-display) 70%, transparent);
	}

	/* Figma 176:1347 — 48px. */
	.tagline {
		font-size: clamp(26px, 4.1vw, 48px);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-display);
	}

	.portrait {
		flex: 0 0 auto;
		width: clamp(140px, 23.5vw, 277px);
		aspect-ratio: 277 / 297;
		border-radius: 23px;
		overflow: hidden;
	}

	.portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			align-items: center;
			/* Stacked, the two need breathing room the side-by-side layout doesn't. */
			gap: clamp(24px, 5vw, 40px);
		}

		/* The designed break sits after "human-centered"; below this width the
		   line is too narrow for it, so let the text wrap on its own. */
		.line-break {
			display: none;
		}

		.portrait {
			width: 100%;
			max-width: 320px;
			aspect-ratio: 4 / 3;
		}
	}
</style>
