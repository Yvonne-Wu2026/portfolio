---
/* Figma: "Home Page" 24:611 — headline and intro on the left, rounded portrait on the right. */
---

<section class="hero page">
	<div class="text">
		<h1 class="headline">
			<span class="role">UX<img class="heart" src="/icons/heart.svg" alt="and" width="21.9812" height="19.23" />UI</span>
			<span>Designer</span>
		</h1>
		<p class="intro">I’m Yvonne! I create human-centered experiences that are functional, intuitive, and engaging.</p>
	</div>
	<div class="portrait">
		<img
			src="/images/home-hero-portrait.webp"
			alt="Yvonne in glasses, with a grey cat asleep on the sofa behind her"
			width="896"
			height="1200"
		/>
	</div>
</section>

<style>
	/* Figma 24:611 — a 1202px row, 50px vertical padding, text and photo pushed apart. */
	.hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(32px, 5vw, 92px);
		max-width: calc(1202px + 2 * var(--gutter));
		padding-block: 50px;
		color: var(--color-ink);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: clamp(16px, 2vw, 30px);
		max-width: 724px;
		min-width: 0;
	}

	/* Figma 24:613 — "UX ♥ UI" and "DESIGNER" sit 20px apart on one line. */
	.headline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 0.23em;
		font-family: var(--font-playfair);
		font-size: clamp(48px, 5.97vw, 86px);
		font-weight: 700;
		line-height: 1.33;
		text-transform: uppercase;
	}

	.role {
		display: inline-flex;
		align-items: center;
		gap: 0.07em;
	}

	/* Figma 24:616 — a 24px icon frame around the 22×19 glyph. */
	.heart {
		flex: 0 0 auto;
		margin-inline: 1px;
	}

	.intro {
		font-size: clamp(22px, 2.5vw, 36px);
		font-weight: 500;
		line-height: 1.2;
	}

	/* Figma 24:627 — 386×370 with a 107px corner radius. */
	.portrait {
		flex: 0 0 auto;
		width: clamp(220px, 26.8vw, 386px);
		aspect-ratio: 386 / 370;
		border-radius: 27.7%;
		overflow: hidden;
	}

	.portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 760px) {
		.hero {
			flex-direction: column-reverse;
			align-items: flex-start;
		}
	}
</style>
