---
/* Figma: "Homepage hero" 176:1343 — centred greeting and tagline. */
import Flower from './Flower.astro';
---

<section class="hero page">
	<div class="text">
		<h1 class="greeting bloom"><span class="greeting-text">Hi, I’m Yvonne</span><Flower /></h1>
		<p class="tagline">I design human-centered solutions that are functional, intuitive, and engaging.</p>
	</div>
</section>

<style>
	/* Figma 176:1343 — the hero is capped at 1178px and centres in the column,
	   rather than spreading to the full 1296px. The vw coefficients below are
	   set so every value reaches its designed size at the same point, keeping
	   the whole block in proportion as it scales. */
	.hero {
		display: flex;
		align-items: center;
		max-width: calc(1178px + 2 * var(--gutter));
		padding-block: clamp(48px, 7vw, 93px);
	}

	.text {
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		min-width: 0;
		/* Figma 176:1345 — 30px between the two lines, and the block is centred. */
		gap: clamp(16px, 2.55vw, 30px);
		text-align: center;
	}

	/* Figma 176:1346 was 86px; enlarged for the Nority display face. */
	.greeting {
		font-family: var(--font-display);
		font-size: clamp(52px, 8.8vw, 104px);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-display);
	}

	/* Raised so the flower tucks in behind the end of the text. */
	.greeting-text {
		position: relative;
		z-index: 1;
	}

	/* Figma 176:1347 — 48px. */
	.tagline {
		font-size: clamp(26px, 4.1vw, 48px);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-display);
		/* Keep the line length short and centred, then even out the lines
		   rather than hard-coding a break. */
		max-width: 14em;
		margin-inline: auto;
		text-wrap: balance;
	}
</style>
