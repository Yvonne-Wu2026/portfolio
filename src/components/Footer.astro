---
/* Figma: "Contact Section" 31:1154 above the large rounded photo from "Footer" 11:347. */
const contactBody = 'Feel free to reach out to me via email, or connect with me on LinkedIn!';
const email = 'yvonnewu.designs@gmail.com';
const linkedin = 'https://www.linkedin.com/in/yvonne-wu-54b7a335b/';
---

<footer class="footer" id="contact">
	<div class="rule"></div>
	<div class="page inner">
		<div class="contact">
			<h2 class="section-heading">Contact</h2>
			<p class="body-text contact-intro">{contactBody}</p>
			<dl class="contact-grid">
				<dt>Email</dt>
				<dd><a href={`mailto:${email}`}>{email}</a></dd>
				<dt>LinkedIn</dt>
				<dd>
					<a class="link-accent" href={linkedin} target="_blank" rel="noopener noreferrer">
						LinkedIn Profile
					</a>
				</dd>
			</dl>
		</div>
		<div class="photo">
			<img
				src="/images/footer-cats.webp"
				alt="Three cats resting on the tiers of a cat tree beside a sunlit window"
				width="1920"
				height="2560"
				loading="lazy"
			/>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding-top: clamp(58px, calc(6vw + 10px), 90px);
		padding-bottom: 50px;
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 50px;
		padding-top: 50px;
	}

	.contact {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: clamp(32px, 4vw, 53px);
	}

	.contact-intro {
		max-width: 1296px;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
		font-size: 24px;
		line-height: 1.3;
	}

	.contact-grid dt,
	.contact-grid dd {
		padding: 10px;
	}

	.contact-grid dd {
		text-align: right;
	}

	.contact-grid a:hover {
		text-decoration: underline;
	}

	.link-accent {
		color: var(--color-link);
		text-decoration: underline;
	}

	.photo {
		align-self: center;
		width: clamp(240px, 30vw, 430px);
		aspect-ratio: 430 / 515;
		border-radius: clamp(36px, 5vw, 72px);
		overflow: hidden;
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 860px) {
		/* Below ~780px the email is wider than its column, and an address
		   is one unbreakable word, so stack the pairs instead. */
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.contact-grid dd {
			text-align: left;
			/* Last resort on very narrow phones: break the address rather
			   than let it push the page into horizontal scroll. */
			overflow-wrap: anywhere;
		}
	}
</style>
