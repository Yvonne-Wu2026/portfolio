---
/* Colophon for the reading pages: a short note on where to write, and a
   closing line about how the book was made. */
import { contact } from '../data/library';
---

<footer class="footer">
	<div class="page inner">
		<p class="ornament" aria-hidden="true">❦</p>
		<h2 class="heading">Correspondence</h2>
		<p class="body">Feel free to reach out by letter — email will do — or find me on LinkedIn.</p>
		<ul class="channels">
			<li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
			<li><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
			<li><a href={contact.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
		</ul>
		<p class="colophon">
			Designed in Figma, set in Cormorant &amp; EB Garamond, built with Claude Code, and kept on Cloudflare.
		</p>
	</div>
</footer>

<style>
	.footer {
		padding-block: clamp(56px, 7vw, 96px);
		background:
			radial-gradient(ellipse at 50% 0%, rgba(217, 162, 76, 0.14), transparent 60%),
			var(--color-espresso);
		color: var(--color-ivory);
		border-top: 1px solid rgba(176, 141, 87, 0.55);
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		text-align: center;
	}

	.heading {
		font-family: var(--font-display);
		font-size: var(--fs-h2);
		font-weight: 600;
		font-style: italic;
		line-height: 1.1;
		color: var(--color-brass-light);
	}

	.body {
		max-width: 46ch;
		font-size: var(--fs-body);
		color: rgba(246, 239, 224, 0.85);
	}

	.channels {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px 36px;
		margin-top: 8px;
	}

	.channels a {
		font-size: var(--fs-body);
		color: var(--color-ivory);
		text-decoration: underline;
		text-decoration-color: rgba(176, 141, 87, 0.7);
		text-underline-offset: 5px;
		overflow-wrap: anywhere;
		transition: color 200ms ease;
	}

	.channels a:hover {
		color: var(--color-brass-light);
	}

	.colophon {
		margin-top: 32px;
		font-size: 15px;
		font-style: italic;
		color: rgba(220, 194, 140, 0.7);
	}

	.footer :focus-visible {
		outline-color: var(--color-brass-light);
	}
</style>
