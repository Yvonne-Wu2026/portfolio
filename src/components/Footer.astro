---
/* Figma: "Footer" 24:866 — dark band with the Contact block and three contact links. */
const contactBody = 'Feel free to reach out to me via email, or connect with me on LinkedIn!';
const email = 'yvonnewu.designs@gmail.com';
const linkedin = 'https://www.linkedin.com/in/yvonne-wu-54b7a335b/';
const instagram = 'https://www.instagram.com/threepudgybeans/';
---

<footer class="footer" id="contact">
	<div class="footer-rule"></div>
	<div class="page inner">
		<div class="intro">
			<h2 class="heading">Contact</h2>
			<p class="body">{contactBody}</p>
		</div>
		<ul class="channels">
			<li>
				<a class="channel" href={`mailto:${email}`}>
					<img src="/icons/email.svg" alt="" width="28.5" height="26.5" />
					<span>{email}</span>
				</a>
			</li>
			<li>
				<a class="channel" href={linkedin} target="_blank" rel="noopener noreferrer">
					<img src="/icons/linkedin.svg" alt="" width="28.9979" height="29" />
					<span>LinkedIn</span>
				</a>
			</li>
			<li>
				<a class="channel" href={instagram} target="_blank" rel="noopener noreferrer">
					<img src="/icons/instagram.svg" alt="" width="29" height="29" />
					<span>Instagram</span>
				</a>
			</li>
		</ul>
	</div>
</footer>

<style>
	/* Figma 24:866 — 110px above the rule, 100px below the links. */
	.footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 50px;
		padding-top: clamp(64px, 7.6vw, 110px);
		padding-bottom: clamp(56px, 6.9vw, 100px);
		background-color: var(--color-chrome);
	}

	/* Figma 24:794 — 1350px, 3px, butter. */
	.footer-rule {
		width: calc(100% - 2 * var(--gutter));
		max-width: 1350px;
		border-top: 3px solid var(--color-butter);
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 50px;
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 30px;
		text-align: center;
	}

	.heading {
		font-family: var(--font-playfair);
		font-size: clamp(40px, 4.44vw, 64px);
		font-weight: 700;
		line-height: 1.33;
		text-transform: uppercase;
		color: var(--color-butter);
	}

	.body {
		font-size: clamp(18px, 1.67vw, 24px);
		line-height: 1.2;
		color: var(--color-cream);
	}

	/* Figma 24:831 — the LinkedIn item sits centred in a 406px slot,
	   which leaves ~133px either side of it. */
	.channels {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 16px clamp(24px, 9.2vw, 133px);
	}

	.channel {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: clamp(18px, 1.67vw, 24px);
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-sky);
		overflow-wrap: anywhere;
	}

	.channel img {
		flex: 0 0 auto;
	}

	a.channel:hover span {
		text-decoration: underline;
	}

	.footer :focus-visible {
		outline-color: var(--color-butter);
	}
</style>
