---
/* Figma: "Footer" 11:347 — Email / Socials row above a large rounded photo. */
const email = 'yvonnewu.designs@gmail.com';
const socials = [
	{ label: 'Instagram', href: 'https://instagram.com/', icon: '/icons/instagram.svg' },
	{ label: 'LinkedIn', href: 'https://linkedin.com/', icon: '/icons/linkedin.svg' },
];
---

<footer class="footer">
	<div class="rule"></div>
	<div class="page inner">
		<div class="grid">
			<p class="label">Email</p>
			<p class="label label--right">Socials</p>
			<p class="value">
				<a href={`mailto:${email}`}>{email}</a>
			</p>
			<ul class="socials">
				{
					socials.map((social) => (
						<li>
							<a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
								<img src={social.icon} alt="" width="24" height="24" />
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="photo">
			<img
				src="/images/footer-cats.webp"
				alt="Three cats resting on the tiers of a cat tree beside a sunlit window"
				width="1920"
				height="2560"
				loading="lazy"
			/>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding-top: clamp(56px, 8vw, 110px);
		padding-bottom: 50px;
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 50px;
		padding-top: 50px;
	}

	.grid {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 10px;
	}

	.label,
	.value {
		padding: 10px;
		font-size: clamp(16px, 1.4vw, 20px);
		line-height: 1.3;
	}

	.label--right {
		text-align: right;
	}

	.value {
		font-weight: 600;
	}

	.value a:hover {
		text-decoration: underline;
	}

	.socials {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 7px;
		padding: 10px;
	}

	.socials img {
		width: 24px;
		height: 24px;
	}

	.socials a {
		display: block;
		transition: opacity 150ms ease;
	}

	.socials a:hover {
		opacity: 0.6;
	}

	.photo {
		width: clamp(240px, 30vw, 430px);
		aspect-ratio: 430 / 515;
		border-radius: clamp(36px, 5vw, 72px);
		overflow: hidden;
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
