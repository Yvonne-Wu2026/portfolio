---
/* A little smiling flower on a soft glow. It sways gently until its parent
   `.bloom` is hovered (or tapped, on touch screens), then spins by one petal,
   grows a touch and smiles wider. */
const petals = [0, 72, 144, 216, 288];
---

<span class="flower" aria-hidden="true">
	<span class="glow"></span>
	<svg viewBox="0 0 100 100">
		<g class="petals">
			{petals.map((angle) => <ellipse cx="50" cy="27" rx="18" ry="21" transform={`rotate(${angle} 50 50)`} />)}
		</g>
		<circle class="centre" cx="50" cy="50" r="16" />

		<g class="face face--calm">
			<path d="M43.5 47 v3 M56.5 47 v3" />
			<path d="M46.5 55 q3.5 3 7 0" />
		</g>
		<g class="face face--happy">
			<path d="M41.5 49.5 q2 -3.5 4 0 M54.5 49.5 q2 -3.5 4 0" />
			<path d="M45.5 54 q4.5 5.5 9 0" />
			<ellipse class="blush" cx="39.5" cy="54.5" rx="2.6" ry="1.6" />
			<ellipse class="blush" cx="60.5" cy="54.5" rx="2.6" ry="1.6" />
		</g>
	</svg>
</span>

<script>
	// Touch screens have no hover, so a tap makes the flower bloom for a moment.
	const BLOOM_MS = 3000;
	for (const el of document.querySelectorAll<HTMLElement>('.bloom')) {
		let timer: number | undefined;
		el.addEventListener('click', () => {
			el.classList.add('is-blooming');
			clearTimeout(timer);
			timer = window.setTimeout(() => el.classList.remove('is-blooming'), BLOOM_MS);
		});
	}
</script>

<style>
	.flower {
		position: relative;
		/* Its own layer, so the glow's negative z-index stays inside the flower.
		   The parent raises its text above this to tuck the flower behind it. */
		z-index: 0;
		display: inline-block;
		width: 1.5em;
		height: 1.5em;
		/* A small gap after the name, and trim top and bottom so the
		   flower doesn't make the heading line taller. */
		margin: -0.35em 0 -0.35em 0.05em;
		/* Centres the flower on the capital letters' height. */
		vertical-align: -0.1em;
	}

	.glow {
		position: absolute;
		inset: -30%;
		z-index: -1;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			color-mix(in srgb, #f9e7a6 80%, transparent) 0%,
			color-mix(in srgb, #f9e7a6 40%, transparent) 45%,
			transparent 70%
		);
		opacity: 0.6;
		transition:
			opacity 500ms ease,
			transform 500ms ease;
	}

	svg {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		stroke: var(--color-display);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		animation: sway 4s ease-in-out infinite alternate;
	}

	.petals {
		/* Soft white, a touch brighter than the page so the petals read as white. */
		fill: #fffdf8;
		transform-origin: 50px 50px;
		transition: transform 700ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.centre {
		fill: #f6d58a;
	}

	.face {
		fill: none;
		stroke-width: 2.6;
		transition: opacity 200ms ease;
	}

	.face--happy {
		opacity: 0;
	}

	.blush {
		fill: #ea8f86;
		stroke: none;
	}

	/* Blooming ----------------------------------------------------------- */

	:global(.bloom:hover) .glow,
	:global(.bloom.is-blooming) .glow {
		opacity: 1;
		transform: scale(1.2);
	}

	/* One petal's turn (72°), so it lands looking the same but alive. */
	:global(.bloom:hover) .petals,
	:global(.bloom.is-blooming) .petals {
		transform: rotate(72deg) scale(1.06);
	}

	:global(.bloom:hover) .face--calm,
	:global(.bloom.is-blooming) .face--calm {
		opacity: 0;
	}

	:global(.bloom:hover) .face--happy,
	:global(.bloom.is-blooming) .face--happy {
		opacity: 1;
	}

	@keyframes sway {
		from {
			transform: rotate(-6deg);
		}
		to {
			transform: rotate(6deg);
		}
	}
</style>
