---
/* Closing navigation for a case study: on to the next one, or back up.
   Not in the Figma file — built from the existing type scale and rule styles. */
interface Props {
	next?: { title: string; slug: string };
}

const { next } = Astro.props;
---

<nav class="case-nav" aria-label="Case study navigation">
	<div class="rule"></div>
	<div class="page inner">
		{
			next && (
				<div class="next">
					<p class="label small-caps">Next on the shelf</p>
					<a class="next-link" href={`/work/${next.slug}`}>
						<span>{next.title}</span>
						<img class="arrow" src="/icons/arrow-right.svg" alt="" width="32" height="32" />
					</a>
				</div>
			)
		}
		<div class="links">
			<a class="top-link" href="/work">All work</a>
			<a class="top-link" href="#top">Back to top</a>
		</div>
	</div>
</nav>

<style>
	.case-nav {
		display: flex;
		flex-direction: column;
		gap: 50px;
		padding-block: clamp(28px, 3.5vw, 50px);
	}

	.inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.next {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 10px;
	}

	.label {
		font-size: 16px;
		line-height: 1.3;
		color: var(--color-burgundy);
	}

	.links {
		display: flex;
		gap: 8px 24px;
	}

	.next-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		font-style: italic;
		font-weight: 600;
		line-height: 1.2;
	}

	.next-link:hover span,
	.next-link:focus-visible span {
		text-decoration: underline;
	}

	.arrow {
		width: clamp(22px, 2.2vw, 32px);
		height: clamp(22px, 2.2vw, 32px);
		flex: 0 0 auto;
		/* Figma mirrors the mi:arrow-left asset to point right. */
		transform: scaleX(-1);
		transition: transform 200ms ease;
	}

	.next-link:hover .arrow,
	.next-link:focus-visible .arrow {
		transform: scaleX(-1) translateX(-6px);
	}

	.top-link {
		padding: 10px;
		font-size: clamp(16px, 1.4vw, 19px);
		font-style: italic;
		line-height: 1.3;
	}

	.top-link:hover,
	.top-link:focus-visible {
		text-decoration: underline;
	}

	@media (max-width: 700px) {
		.inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}
	}
</style>
