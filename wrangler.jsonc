{
  // Static-assets-only Worker: no `main`, so Cloudflare serves ./dist directly.
  // This file also stops `wrangler deploy` from running its auto-config flow,
  // which would otherwise `astro add cloudflare` an adapter this site
  // (output: "static", no SSR) does not need.
  "name": "portfolio",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist"
  }
}
